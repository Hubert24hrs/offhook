# OFFHOOK — Environment Variables
# Copy this file to .env.local for local dev overrides (already in .gitignore)
# For EAS Build production secrets, add these via:
#   eas secret:create --scope project --name EXPO_PUBLIC_CLAUDE_API_KEY --value sk-ant-...

# ─── Anthropic Claude API ─────────────────────────────────────────────────
# Your Claude API key from https://console.anthropic.com
# Leave blank to use the built-in offline excuse engine (mock AI)
EXPO_PUBLIC_CLAUDE_API_KEY=

# ─── RevenueCat ───────────────────────────────────────────────────────────
# iOS SDK key from https://app.revenuecat.com → App Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Android SDK key from https://app.revenuecat.com → App Settings → API Keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ─── Sentry ───────────────────────────────────────────────────────────────
# DSN from https://sentry.io
EXPO_PUBLIC_SENTRY_DSN=

# ─── PostHog ──────────────────────────────────────────────────────────────
# API key from https://app.posthog.com
EXPO_PUBLIC_POSTHOG_API_KEY=
